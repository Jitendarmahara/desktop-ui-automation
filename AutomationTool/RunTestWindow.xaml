<Window x:Class="AutomationTool.RunTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run a Test" Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pick a saved test to see what it does, then run it." FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Saved tests" FontWeight="Bold" Margin="0,0,0,6"/>
                <Button DockPanel.Dock="Bottom" x:Name="BrowseButton" Content="Browse for another file..." Padding="8,4" Margin="0,8,0,0" Click="OnBrowseClick"/>
                <ListBox x:Name="TestFilesList" SelectionChanged="OnTestFileSelected"/>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="TestNameText" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="TestTargetText" Foreground="Gray"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Recorded steps" FontWeight="Bold" Margin="0,4,0,6"/>
                <ListBox x:Name="StepsPreviewList" FontFamily="Consolas" FontSize="12"/>
            </DockPanel>
        </Grid>

        <Button Grid.Row="2" x:Name="RunButton" Content="Run Selected Test" Padding="18,10" HorizontalAlignment="Left"
                FontSize="14" FontWeight="SemiBold" Background="#1565C0" Foreground="White" BorderThickness="0"
                IsEnabled="False" Click="OnRunClick" Margin="0,0,0,12"/>

        <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"/>
        </Border>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,10,0,0" Foreground="Gray"/>
    </Grid>
</Window>
