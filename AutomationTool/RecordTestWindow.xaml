<Window x:Class="AutomationTool.RecordTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording" Width="360" SizeToContent="Height"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" WindowStyle="ToolWindow">
    <StackPanel Margin="14">

        <!-- Visible until attached -->
        <StackPanel x:Name="AttachPanel">
            <TextBlock Text="Process name:" FontSize="11" Foreground="Gray"/>
            <TextBox x:Name="ProcessNameBox" Text="SampleTargetApp" Margin="0,2,0,8" Padding="4"/>
            <TextBlock Text="Window title contains (optional):" FontSize="11" Foreground="Gray"/>
            <TextBox x:Name="TitleFilterBox" Margin="0,2,0,8" Padding="4"/>
            <Button x:Name="AttachButton" Content="Attach" Padding="10,6" Background="#455A64"
                    Foreground="White" BorderThickness="0" Click="OnAttachClick" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Visible after attach -->
        <StackPanel x:Name="RecordingStatusPanel" Visibility="Collapsed" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="Red" Margin="0,0,6,0"/>
                <TextBlock Text="Recording" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock x:Name="TargetNameText" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <TextBlock x:Name="StepCountText" Text="0 steps captured" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ListBox x:Name="StepsList" Height="140" FontSize="11" FontFamily="Consolas"/>

        <Expander x:Name="ManualStepExpander" Header="Add manual step (button clicks, assertions)"
                  Margin="0,10,0,0" Expanded="OnManualExpanderExpanded">
            <StackPanel Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Elements" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="RefreshButton" Content="Refresh" Padding="8,2" IsEnabled="False" Click="OnRefreshClick"/>
                </StackPanel>
                <ListBox x:Name="ElementsList" Height="110" Margin="0,0,0,8" SelectionChanged="OnElementSelected"/>
                <TextBlock Text="Action/Assertion:" FontSize="11" Foreground="Gray"/>
                <ComboBox x:Name="ActionCombo" Margin="0,2,0,6" SelectionChanged="OnActionSelected"/>
                <TextBlock x:Name="ValueLabel" Text="Value:" FontSize="11" Foreground="Gray" Visibility="Collapsed"/>
                <TextBox x:Name="ValueBox" Margin="0,2,0,8" Padding="4" Visibility="Collapsed"/>
                <Button x:Name="AddStepButton" Content="Add Step" Padding="10,6" Background="#2E7D32"
                        Foreground="White" BorderThickness="0" IsEnabled="False" Click="OnAddStepClick" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Expander>

        <TextBlock x:Name="StatusText" Margin="0,10,0,10" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="10,6" Margin="0,0,6,0" Click="OnCancelClick"/>
            <Button x:Name="FinishButton" Content="Finish &amp; Save" Padding="10,6" Background="#1565C0"
                    Foreground="White" BorderThickness="0" IsEnabled="False" Click="OnFinishClick"/>
        </StackPanel>
    </StackPanel>
</Window>
