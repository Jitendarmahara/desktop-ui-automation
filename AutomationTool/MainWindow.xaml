<Window x:Class="AutomationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="No-Code Desktop UI Automation Tool" Height="320" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="No-Code Desktop UI Automation Tool" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Record a test by picking elements from a running app, then replay it later." Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="RecordButton" Content="Record New Test" Padding="22,14" Margin="0,0,16,0"
                    FontSize="15" FontWeight="SemiBold" Background="#2E7D32" Foreground="White" BorderThickness="0"
                    Click="OnRecordTestClick"/>
            <Button x:Name="RunButton" Content="Run Test" Padding="22,14"
                    FontSize="15" FontWeight="SemiBold" Background="#1565C0" Foreground="White" BorderThickness="0"
                    Click="OnRunTestClick"/>
        </StackPanel>
    </Grid>
</Window>
